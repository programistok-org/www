---

<section class="mx-auto max-w-[1200px] px-5 py-8 sm:px-8 lg:py-14" aria-labelledby="partnerzy-title">
  <p class="mb-4 font-mono text-[13px] uppercase tracking-[0.14em] text-faint">// Wsparcie</p>
  <h2 id="partnerzy-title" class="max-w-[22ch] text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-[1.05] tracking-[-0.03em]">
    Programistok powstaje przy współpracy i dzięki wsparciu
  </h2>

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    {hosts.map((p) => (
      <article class="flex flex-col rounded-3xl border border-line bg-surface p-8 sm:p-10">
        <div class="mb-6 flex min-h-[48px] items-center">
          <img src={p.logo} alt={p.name} class={`${p.logoClass} w-auto max-w-full`} />
        </div>
        <p class="flex-1 text-[15px] leading-relaxed text-muted text-pretty">{p.description}</p>
        <a
          href={p.href}
          rel="noopener"
          target="_blank"
          class="mt-6 inline-flex items-center gap-2 self-start font-mono text-[13px] uppercase tracking-wide text-accent-ink transition-colors hover:text-ink"
        >
          {p.href.replace('https://', '')} <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>

  <p class="mt-12 font-mono text-[13px] uppercase tracking-[0.14em] text-faint">// Sponsorzy</p>
  <div class="mt-5 grid gap-5 md:grid-cols-2">
    {sponsors.map((s) => (
      <article class="flex flex-col rounded-3xl border border-line bg-surface p-8 sm:p-10">
        <div class="mb-6 flex min-h-[48px] items-center">
          <img src={s.logo} alt={s.name} class={`${s.logoClass} w-auto max-w-full`} />
        </div>
        <p class="flex-1 text-[15px] leading-relaxed text-muted text-pretty">{s.description}</p>
        <a
          href={s.href}
          rel="noopener"
          target="_blank"
          class="mt-6 inline-flex items-center gap-2 self-start font-mono text-[13px] uppercase tracking-wide text-accent-ink transition-colors hover:text-ink"
        >
          {s.href.replace('https://', '')} <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>

  <p class="mt-12 font-mono text-[13px] uppercase tracking-[0.14em] text-faint">// Partnerzy</p>
  <div class="mt-5 grid gap-5 md:grid-cols-3">
    {partners.map((i) => (
      <article class="flex flex-col rounded-3xl border border-line bg-surface p-7 sm:p-8">
        <div class="mb-5 flex min-h-[56px] items-center">
          <img src={i.logo} alt={i.name} loading="lazy" class={`${i.logoClass} w-auto max-w-full`} />
        </div>
        <p class="flex-1 text-[14px] leading-relaxed text-muted text-pretty">{i.description}</p>
        <a
          href={i.href}
          rel="noopener"
          target="_blank"
          class="mt-5 inline-flex items-center gap-2 self-start font-mono text-[12px] uppercase tracking-wide text-accent-ink transition-colors hover:text-ink"
        >
          {i.linkLabel ?? i.href.replace('https://', '')} <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>

</section>
