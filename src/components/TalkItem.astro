---
import { youtubeEmbedUrl } from '../lib/youtube.js';

const { talk } = Astro.props;
const { title, speaker, shortDescription, youtubeUrl } = talk;
const embed = youtubeEmbedUrl(youtubeUrl);
---

<article class="flex flex-col overflow-hidden rounded-3xl border border-line bg-surface">
  {embed && (
    <div class="aspect-video border-b border-line bg-black">
      <iframe
        src={embed}
        title={`Wideo: ${title}`}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        class="h-full w-full"
      ></iframe>
    </div>
  )}
  <div class="p-6">
    <h3 class="text-lg font-black tracking-[-0.01em]">{title}</h3>
    {speaker && <p class="mt-1 font-mono text-[13px] uppercase tracking-wide text-accent-ink">{speaker}</p>}
    {shortDescription && <p class="mt-3 text-sm leading-relaxed text-muted">{shortDescription}</p>}
  </div>
</article>
