---
import { days, tracks, sessionsFor, cardFor } from '../lib/agenda.js';

const isTalk = (s) => s.kind === 'talk' || s.kind === 'lt';

// osobny pas dla każdej pary dzień × ścieżka, sąsiednie jadą w przeciwne strony
const rows = days.flatMap((day) =>
  tracks.map((track) => ({
    key: `${day.id}-${track.id}`,
    label: `${day.label} · ${track.label}`,
    track: track.id,
    items: sessionsFor(track.id, day.id)
      .filter(isTalk)
      .map(cardFor)
      .filter((s) => s.topic)
      .map((s) => ({ topic: s.topic, name: s.name })),
  }))
).filter((row) => row.items.length > 0);

const theme = {
  it: { dot: 'bg-accent', chip: 'bg-accent/10 text-accent-ink' },
  biznes: { dot: 'bg-biz', chip: 'bg-biz/10 text-biz-ink' },
};
---

<div class="relative left-1/2 mt-9 w-screen -translate-x-1/2 overflow-hidden py-1" aria-hidden="true">
  {rows.map((row, i) => (
    <div class={`marquee ${i % 2 === 1 ? 'marquee--reverse' : ''} py-1.5`}>
      <div class="marquee__track">
        {[0, 1].map(() => (
          <ul class="flex shrink-0 items-center gap-8 pr-8">
            <li class="shrink-0">
              <span class={`inline-flex whitespace-nowrap rounded-full px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.1em] ${theme[row.track].chip}`}>
                {row.label}
              </span>
            </li>
            {row.items.map((item) => (
              <li class="flex shrink-0 items-center gap-3">
                <span class={`h-2 w-2 shrink-0 rounded-[2px] ${theme[row.track].dot}`}></span>
                <span class="whitespace-nowrap text-[15px] font-bold tracking-[-0.01em] text-ink">{item.topic}</span>
                <span class="whitespace-nowrap font-mono text-[12px] uppercase tracking-[0.1em] text-faint">{item.name}</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  ))}
</div>
