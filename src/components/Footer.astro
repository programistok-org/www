---
import Logo from './Logo.astro';

const socials = [
  { href: 'https://www.facebook.com/programistok', label: 'Facebook' },
  { href: 'https://www.linkedin.com/company/programistok-conference', label: 'LinkedIn' },
  { href: 'https://www.youtube.com/@programistok', label: 'YouTube' },
];
---

<footer class="border-t border-white/10 bg-ink text-cream-faint">
  <div class="mx-auto max-w-[1200px] px-5 pb-12 pt-14 sm:px-8 lg:px-16 lg:pt-20">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <div class="mb-4 flex items-center gap-3">
          <Logo size={34} src="/programistok-sygnet-white.svg" />
          <span class="text-lg font-extrabold text-cream">Programistok</span>
        </div>
        <p class="text-sm leading-relaxed text-cream-faint">
          Programistok powstaje we współpracy i dzięki wsparciu Fundacji INFOTECH oraz Wydziału Informatyki Politechniki Białostockiej.
        </p>
      </div>

      <div>
        <h2 class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.12em] text-cream-faint">Social media</h2>
        <ul class="flex flex-col gap-2.5 text-sm">
          {socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" class="transition-colors hover:text-cream">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.12em] text-cream-faint">Informacje</h2>
        <ul class="flex flex-col gap-2.5 text-sm">
          <li><a href="https://tinyurl.com/programistok-regulamin" rel="noopener" target="_blank" class="transition-colors hover:text-cream">Regulamin konferencji</a></li>
          <li><a href="https://tinyurl.com/programistok-polityka" rel="noopener" target="_blank" class="transition-colors hover:text-cream">Polityka prywatności</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
