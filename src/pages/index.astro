---
// Hack-a-stok @ Programistok 2027 — temporarily the homepage; the Programistok 2026 site lives at /2026.
// Ported from the makers-meet-industry React app (static content, no client JS).
import '../styles/hackastok.css';
import Newsletter from '../components/Newsletter.astro';

const title = 'Hack-a-stok by Programistok';
const description =
  'Prawdziwe problemy. Świeże pomysły. Jeden weekend. Hackathon, na którym programiści i firmy z Podlasia wspólnie budują działające prototypy.';
// '/' on programistok.org; '/hack/' for the preview build (astro build --base /hack/) at hzub.github.io/hack
const base = import.meta.env.BASE_URL;
const asset = (name) => `${base}hack-a-stok/${name}`;
const archiveUrl = `${base}2026`;

const companiesFormUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSfJtN3HhNF-XEplfgfdKXxdLIK2NE6sY1-sl4yYt9RjOzf26g/viewform';
const hackersFormUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSfuhncu3Ikc7-rhW6SeQ5XUMlXGw5L2eVsM-tFNqVWiAXYzjw/viewform';

const ctaClass =
  'inline-block content-center border-2 border-foreground px-8 py-4 text-lg font-semibold shadow-[6px_6px_0_0_var(--foreground)] transition hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[4px_4px_0_0_var(--foreground)]';
const signupClass = `${ctaClass} bg-primary text-primary-foreground`;
const notifyClass = `${ctaClass} bg-ochre text-foreground`;
// for the red closing section, where a red button would vanish
const paperClass = `${ctaClass} bg-background text-foreground`;

const manifesto = [
  'Problemy w firmach rzadko czekają dlatego, że są trudne. Czekają, bo nikt nie miał czasu sprawdzić, jak je rozwiązać.',
  'Białystok nie musi kopiować Warszawy ani Berlina. Budujemy stąd i dla tego miejsca.',
  'Kod ma swoje miejsce na hali produkcyjnej, w piekarni, w centrum logistycznym — nie tylko w prezentacjach.',
  'Programiści i przemysł mówią różnymi językami. Przez jeden weekend uczymy się nawzajem swoich.',
  'Zostajemy. Talenty z Podlasia zasługują na problemy warte rozwiązania tu, u siebie.',
  'Działający prototyp jest lepszy niż idealny plan.',
];

// [title, text, weekend time slot]
const steps = [
  [
    'Firmy zgłaszają problemy',
    'Firma opisuje, co nie działa, kogo to dotyczy i jak wyglądałby sukces. Nie musi znać rozwiązania ani używać technicznego języka.',
  ],
  [
    'Przygotowujemy wyzwania',
    'Rada programowa — doświadczeni praktycy IT i biznesu — razem z firmą zamienia zgłoszenie w precyzyjnie opisane wyzwanie na weekend.',
  ],
  [
    'Wybieramy zespoły',
    'Zespoły i pojedynczy specjaliści zgłaszają się do udziału, a mentorzy wybierają tych, którzy mają największe szanse dowieźć wartościowe rozwiązanie.',
  ],
  [
    'Start',
    'Firmy przedstawiają swoje problemy osobiście, bez slajdów. Zespoły zadają pytania i zaczynają pracę.',
    'Pt · 16:00–24:00',
  ],
  [
    'Praca',
    'Zespoły budują rozwiązania pod okiem mentorów i w ustalonych momentach konsultują kierunek z firmą.',
    'Sb · 8:00–24:00',
  ],
  [
    'Finał',
    'Zespoły prezentują działające prototypy. Każda firma wybiera najlepsze rozwiązanie swojego problemu i wręcza nagrodę.',
    'Nd · 10:00–20:00',
  ],
];

const details = [
  ['Kiedy', 'Marzec 2027 (dokładna data wkrótce)'],
  ['Gdzie', 'Białystok (miejsce ogłosimy wkrótce)'],
  ['Dla kogo', 'Programiści, projektanci, studenci i firmy z Podlasia'],
  ['Organizator', 'Programistok — pro-bono, od 2015'],
];

const history = [
  ['2015', 'Programistok rusza'],
  ['2026', 'Ścieżka biznesowa'],
  ['2027', 'Hackathon'],
];

// lucide icons "factory" and "laptop"
const icons = {
  factory: [
    'M12 16h.01',
    'M16 16h.01',
    'M3 19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.5a.5.5 0 0 0-.769-.422l-4.462 2.844A.5.5 0 0 1 15 10.5v-2a.5.5 0 0 0-.769-.422L9.77 10.922A.5.5 0 0 1 9 10.5V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z',
    'M8 16h.01',
  ],
  laptop: [
    'M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z',
    'M20.054 15.987H3.946',
  ],
};

const audiences = [
  {
    title: 'Dla firm',
    icon: icons.factory,
    colors: 'bg-ochre text-foreground',
    lead: 'Masz problem, który od dawna czeka na rozwiązanie? Zgłoś go — przez jeden weekend kilka zespołów programistów i specjalistów IT będzie nad nim pracować pod okiem doświadczonych mentorów. W niedzielę zobaczysz działające prototypy.',
    items: [
      [
        'Jakich problemów szukamy',
        'Takich, które bolą na co dzień: ręczne raportowanie, rozproszone systemy, przepisywanie faktur i zamówień, planowanie w arkuszu, prognozowanie „na wyczucie”, wiedza zamknięta w głowach, kontrola jakości „na oko”. Nie wiesz, czy Twój problem się nada? Zgłoś go mimo to — rada programowa pomoże wybrać fragment, który da się rozwiązać w weekend.',
      ],
      [
        'Co zyskujesz',
        'Kilka niezależnych podejść do jednego problemu, działające prototypy zamiast slajdów, świeże spojrzenie spoza branży, wiedzę przed decyzją o inwestycji, kontakt ze specjalistami z regionu i widoczność jako partner wydarzenia',
      ],
      [
        'Czego się spodziewać',
        'Nie gotowego systemu, tylko odpowiedzi na pytanie, czy i jak problem da się rozwiązać — zanim zaangażujesz budżet',
      ],
      [
        'Czego potrzebujemy',
        'Opisu problemu (1–2 godz.), rozmowy z radą programową (ok. 1 godz.), przykładowych danych, jeśli są potrzebne, i jednej osoby, która zna problem: ok. 1 godz. na starcie w piątek, krótkie konsultacje w sobotę (także zdalnie) i ok. 3 godz. na finale w niedzielę',
      ],
      [
        'Dane i prawa',
        'Udostępniasz tylko to, na co się zgodzisz — zwykle wystarczą dane przykładowe lub zanonimizowane. Poufność określi regulamin hackathonu. Zwycięski zespół przekazuje Twojej firmie prawa do prototypu.',
      ],
      [
        'Koszt',
        'Udział bezpłatny — prosimy jedynie o ufundowanie nagrody dla zespołu, który najlepiej rozwiąże Twój problem. Nikt nie będzie Ci niczego sprzedawał: to wydarzenie społeczności, nie spotkanie handlowe.',
      ],
      [
        'Zgłoszenia problemów',
        'Do połowy stycznia 2027, przez formularz poniżej. Pierwsza edycja: tylko 4 wyzwania. Opiszesz w nim, na czym polega problem i kogo dotyczy, jak go dziś rozwiązujecie i ile to kosztuje, jak wyglądałby sukces, jakie dane możecie udostępnić i kto z firmy będzie opiekunem wyzwania.',
      ],
    ],
    cta: 'Zgłoś problem',
    form: companiesFormUrl,
  },
  {
    title: 'Dla hakerów',
    icon: icons.laptop,
    colors: 'bg-umber text-secondary-foreground',
    lead: 'Programujesz, projektujesz albo po prostu lubisz rozwiązywać problemy? Przyjdź zbudować coś, z czego ktoś naprawdę skorzysta.',
    items: [
      ['Udział', 'Bezpłatny'],
      ['Zespoły', 'Zgłoś się z ekipą (2–5 osób) albo solo. Mentorzy wybiorą 12–16 zespołów do 4 wyzwań.'],
      ['Na miejscu', 'Jedzenie, kawa, mentorzy i prawdziwe wyzwania od lokalnych firm'],
      ['Nagrody', 'Każda firma funduje nagrodę dla zespołu, który najlepiej rozwiąże jej problem. Szczegóły wkrótce.'],
      [
        'Prawa do rozwiązań',
        'Rozwiązanie należy do zespołu, który je stworzył. Zwycięski zespół przekazuje firmie prawa do prototypu, a dalszą współpracę możecie ustalić bezpośrednio.',
      ],
    ],
    cta: 'Zapisz się',
    form: hackersFormUrl,
  },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Prawdziwe problemy. Świeże pomysły. Jeden weekend. Zgłoś problem swojej firmy albo dołącz do zespołu."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..900,0..100,0..1;1,9..144,400..900,0..100,0..1&family=Instrument+Sans:wght@400;600&display=swap"
    />

    <!-- same analytics as the rest of programistok.org (BaseLayout) -->
    <script is:inline async src="https://plausible.io/js/pa-BdF1g3bFUj4LoA3_g57ki.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xmir8kmkde");
    </script>
    <script is:inline>
      console.log("%c♥ In loving memory of Paweł Breś", "color:#dc1945;font-size:14px;font-weight:bold");
    </script>
  </head>
  <body>
    <main class="min-h-screen overflow-hidden">
      <header
        class="flex items-center justify-end whitespace-nowrap border-b-2 border-foreground bg-primary px-5 py-2 text-sm font-semibold text-primary-foreground md:px-4"
      >
        <a href={archiveUrl} class="group flex items-center gap-2">
          <span class="border border-current px-1.5 font-archivo text-[10px] uppercase">Archiwum</span>
          <span class="underline underline-offset-4 group-hover:no-underline">Programistok 2026</span>
        </a>
      </header>

      <section class="poster-hero relative grid md:grid-cols-2">
        <div
          class="relative flex flex-col border-b-2 border-foreground px-5 pb-10 pt-7 md:border-b-0 md:border-r-2 md:px-10 md:pb-9"
        >
          <div class="flex flex-col items-start">
            <img src={asset('programistok-z-napisem.svg')} alt="Programistok logo" class="mt-1 w-60" />
            <div>
              <p class="-mt-2 ml-16 text-sm font-bold">przedstawia</p>
            </div>
          </div>
          <!-- typographic logo: Inter Black is 5.69em wide for "Hack-a-stok", so 17cqw fills the slab at any column width -->
          <!-- my-auto centers the logo in the column on desktop, with the register button kept at the bottom;
               the negative right margin widens it into the poster half (the type scales with it) and z-10 lifts it above the image -->
          <div class="@container relative z-10 mt-8 md:my-auto md:-mr-[60%] md:pt-4">
            <h1 class="@container bg-foreground px-5 pb-6 pt-5 font-logo text-background md:px-7">
              <span class="block text-[17cqw] font-black leading-[0.95] tracking-[-0.05em]">
                Hack<span class="text-ochre">-a-</span>stok
              </span>
              <span class="mt-[2cqw] flex items-center gap-[0.35em] text-[4.7cqw] font-medium tracking-[-0.02em]">
                <!-- lucide "map-pin", as on /2026 -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-[1em] shrink-0" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                Białystok, Marzec 2027
              </span>
            </h1>
            <!-- the PDF's three-colour stripe, in this page's palette -->
            <div class="grid h-2.5 grid-cols-3" aria-hidden="true">
              <span class="bg-primary"></span><span class="bg-secondary"></span><span class="bg-ochre"></span>
            </div>
            <!-- line 1 is 18.53em wide: 5.3cqw fills the column on phones; from md the column is 62.5% of this
                 widened block, so 3.3cqw keeps the slogan on the paper, off the poster -->
            <p class="mt-4 font-logo text-[5.3cqw] font-extrabold leading-[1.15] tracking-[-0.02em] md:text-[3.3cqw]">
              Prawdziwe problemy. <span class="text-primary">Świeże pomysły.</span><br />Jeden weekend.
            </p>
            <p class="mt-4 font-logo text-2xl font-black tracking-[-0.03em] md:text-4xl lg:text-5xl">
              <span class="text-primary">IT</span> × <span class="text-secondary">BIZNES</span>
            </p>
          </div>
          <!-- stretch: the one-line button matches the two-line one's height, content-center keeps its label centred -->
          <div class="mt-8 flex flex-wrap items-stretch justify-end gap-6">
            <!-- `!` overrides ctaClass's padding and size: same-property Tailwind classes don't win by order -->
            <a href={hackersFormUrl} target="_blank" rel="noopener" class={`${signupClass} py-3!`}>Zgłoś zespół <span aria-hidden="true">↗</span></a>
            <!-- two lines keep it beside the team button in the half-width column; smaller and tighter to keep the pair low -->
            <a href="#newsletter" class={`${notifyClass} py-3! text-base! leading-tight!`}>Zapisz się<br />do newslettera <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="relative min-h-[60vh] md:min-h-0">
          <img
            src={asset('bialystok-poster-cyber.jpg')}
            alt="European bison wearing illustrated cybernetic sunglasses in the French gardens of Branicki Palace, Białystok, poster illustration"
            width="1024"
            height="1280"
            class="poster-hero-image absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </section>

      <section
        class="border-y-2 border-foreground bg-secondary bg-cover bg-center text-secondary-foreground"
        style={`background-image: url(${asset('manifest-foliage.svg')})`}
      >
        <div class="mx-auto max-w-300 px-5 py-16 md:px-10 md:py-24">
          <h2 class="font-display text-5xl font-black italic md:text-7xl">Co to jest?</h2>
          <p class="mt-8 max-w-3xl text-2xl leading-snug">
            Programistok przedstawia <strong class="font-semibold text-ochre">Hack-a-stok</strong>! To hackathon*, na którym programiści i firmy z Podlasia wspólnie budują
            działające prototypy. Firmy przynoszą prawdziwe problemy, a zespoły przez jeden weekend zamieniają je w
            konkretne rozwiązania.
          </p>
          <p class="mt-6 max-w-3xl text-lg leading-snug">
            (*) Nazwa łączy <em>hack</em> — w żargonie programistów sprytne, nieoczywiste rozwiązanie problemu — i{' '}
            <em>maraton</em>. I nie, nie ma to nic wspólnego z włamywaniem: to weekendowy warsztat projektowy, w którym
            kilka zespołów niezależnie od siebie szuka najlepszego rozwiązania tego samego wyzwania. Sprawdzony format, z
            którego korzystają korporacje, administracja publiczna i uczelnie.
          </p>
          <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
              steps.map(([stepTitle, text, when], i) => (
                <li class="border-2 border-foreground bg-card p-6 text-card-foreground shadow-[6px_6px_0_0_var(--foreground)]">
                  <span class="font-archivo text-sm text-primary">
                    Krok {i + 1}
                    {when && ` · ${when}`}
                  </span>
                  <h3 class="mt-2 font-archivo text-xl">{stepTitle}</h3>
                  <p class="mt-3 leading-snug">{text}</p>
                </li>
              ))
            }
          </ol>
          <dl class="mt-14 grid border-t-2 border-current sm:grid-cols-2 lg:grid-cols-4">
            {
              details.map(([term, value]) => (
                <div class="border-b border-current/30 py-5 sm:pr-6">
                  <dt class="font-archivo text-sm uppercase opacity-70">{term}</dt>
                  <dd class="mt-1 text-xl">{value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- side by side on large screens: colors bleed to the viewport edges, text stays in the 1200px column -->
      <section class="grid border-b-2 border-foreground lg:grid-cols-2">
        {
          audiences.map((a, i) => (
            <div class={`${a.colors} ${i === 0 ? 'border-b-2 border-foreground lg:border-b-0 lg:border-r-2' : ''}`}>
              <div
                class={`mx-auto max-w-300 px-5 py-16 md:px-10 md:py-24 lg:max-w-150 ${i === 0 ? 'lg:mr-0' : 'lg:ml-0'}`}
              >
                <h2 class="flex items-center gap-3 font-display text-4xl font-black italic sm:gap-5 sm:text-5xl md:text-6xl">
                  <span class="flex size-11 shrink-0 items-center justify-center border-2 border-foreground bg-background text-foreground shadow-[4px_4px_0_0_var(--foreground)] sm:size-14 md:size-16">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-6 sm:size-8 md:size-9"
                      aria-hidden="true"
                    >
                      {a.icon.map((d) => <path d={d} />)}
                    </svg>
                  </span>
                  {a.title}
                </h2>
                <p class="mt-6 text-xl leading-snug">{a.lead}</p>
                <dl class="mt-10 border-t-2 border-current">
                  {a.items.map(([term, value]) => (
                    <div class="border-b border-current/30 py-4">
                      <dt class="font-archivo text-sm uppercase opacity-70">{term}</dt>
                      <dd class="mt-1 text-lg leading-snug">{value}</dd>
                    </div>
                  ))}
                </dl>
                <div class="mt-10 flex flex-wrap items-center gap-6">
                  <a href={a.form} target="_blank" rel="noopener" class={signupClass}>{a.cta} <span aria-hidden="true">↗</span></a>
                  {a.cta === 'Zapisz się' && (
                    <a href="#newsletter" class={notifyClass}>Powiadom mnie <span aria-hidden="true">↓</span></a>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </section>

      <section class="border-b-2 border-foreground">
        <div class="mx-auto max-w-300 px-5 py-16 md:px-10 md:py-24">
          <h2 class="font-display text-5xl font-black italic md:text-7xl">Manifest</h2>
          <p class="mt-8 max-w-3xl text-xl leading-snug">
            Wierzymy, że najlepszym sposobem na sprawdzenie pomysłu jest jego zbudowanie. Dlatego zapraszamy firmy z
            regionu, by przyniosły swoje prawdziwe problemy, a ludzi IT, by przez jeden weekend pokazali, jak można je
            rozwiązać — również w sposób, o jakim wcześniej nikt nie myślał.
          </p>
          <ol class="mt-12 grid gap-px md:grid-cols-2">
            {
              manifesto.map((line, i) => (
                <li class="flex gap-5 border-t border-current/30 py-6 md:pr-10">
                  <span class="font-display text-4xl font-black opacity-50">{i + 1}.</span>
                  <span class="text-xl leading-snug">{line}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="border-b-2 border-foreground bg-card">
        <div class="mx-auto max-w-300 px-5 py-16 md:px-10 md:py-24">
          <div class="grid gap-10 md:grid-cols-[2fr_3fr] md:gap-16">
            <div>
              <h2 class="font-display text-5xl font-black italic md:text-7xl">Kim jesteśmy?</h2>
              <ol class="mt-10 flex flex-wrap gap-x-10 gap-y-6">
                {
                  history.map(([year, label]) => (
                    <li>
                      <span class="block font-archivo text-5xl">{year}</span>
                      <span class="font-archivo text-sm uppercase opacity-70">{label}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
            <div class="space-y-5 text-lg leading-snug">
              <p>
                Programistok to konferencja IT organizowana w Białymstoku od 2015 roku: oddolnie, „od społeczności dla
                społeczności”. Przez ponad dekadę stała się jednym z najważniejszych spotkań podlaskiej sceny IT.
              </p>
              <p>
                We wrześniu 2026 roku po raz pierwszy otworzyliśmy ścieżkę biznesową{' '}
                <strong>Digitalizacja Przemysłu @ Programistok</strong>. Przez dwa dni liderzy firm produkcyjnych i
                usługowych rozmawiali o decyzjach technologicznych: co zadziałało, co nie i czego się nauczyli. Mówili nam
                wprost, że takich spotkań powinno być więcej — szczególnie takich, które łączą ludzi IT z biznesem i
                pomagają rozwiązywać realne problemy.
              </p>
              <p class="font-display text-3xl font-black">
                Hackathon jest naszą odpowiedzią. Tym razem nie tylko rozmawiamy o rozwiązaniach.{' '}
                <span class="text-primary">Budujemy je.</span>
              </p>
              <p>
                Działamy całkowicie pro-bono — jesteśmy ludźmi, którym zwyczajnie zależy na swoim regionie. Chcemy
                budować silniejsze Podlasie przez wymianę wiedzy i współpracę, łącząc świat IT z przemysłem i biznesem.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="newsletter" class="border-b-2 border-foreground">
        <div class="mx-auto grid max-w-300 gap-10 px-5 py-16 md:grid-cols-2 md:px-10 md:py-24">
          <div>
            <h2 class="font-display text-5xl font-black italic md:text-7xl">Newsletter</h2>
            <p class="mt-8 max-w-xl text-xl leading-snug">
              Zapisz się do newslettera Programistok, a napiszemy, gdy ogłosimy wyzwania i miejsce hackathonu — i o
              kolejnych wydarzeniach społeczności.
            </p>
          </div>
          <Newsletter inputClass="border-2 border-foreground bg-card px-3 py-2.5" buttonClass={`mt-2 justify-self-start ${signupClass}`} />
        </div>
      </section>

      <section class="bg-primary px-5 py-20 text-center text-primary-foreground md:py-28">
        <p class="mb-6 font-archivo text-lg uppercase">Prawdziwe problemy. Świeże pomysły. Jeden weekend.</p>
        <h2 class="font-display text-5xl font-black md:text-7xl">
          Do zobaczenia
          <br />
          <span class="italic">w Białymstoku.</span>
        </h2>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-6">
          <a href={hackersFormUrl} target="_blank" rel="noopener" class={paperClass}>Zgłoś zespół <span aria-hidden="true">↗</span></a>
          <a href={companiesFormUrl} target="_blank" rel="noopener" class={paperClass}>Zgłoś problem <span aria-hidden="true">↗</span></a>
          <a href="#newsletter" class={notifyClass}>Zapisz się do newslettera <span aria-hidden="true">↑</span></a>
        </div>
      </section>

      <footer class="flex flex-wrap items-center justify-between gap-3 px-5 py-6 text-sm md:px-10">
        <span>
          Hack-a-stok @ Programistok 2027 · Białystok · od społeczności dla społeczności, pro-bono, od 2015
        </span>
        <span>
          Kontakt: <a href="mailto:konferencja@programistok.org" class="underline">konferencja@programistok.org</a> · <a href="https://tinyurl.com/programistok-polityka" rel="noopener" target="_blank" class="underline">Polityka prywatności</a>
        </span>
      </footer>
    </main>
  </body>
</html>
