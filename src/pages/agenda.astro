---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import Cfp from '../components/Cfp.astro';
import agenda from '../data/agenda2026.json';

const tracks = agenda.tracks;
const total = tracks.reduce((n, t) => n + t.slots, 0);

const theme = {
  it: { bar: 'bg-accent', label: 'text-accent-ink', chip: 'bg-accent/10 text-accent-ink', btn: 'bg-accent' },
  biznes: { bar: 'bg-biz', label: 'text-biz-ink', chip: 'bg-biz/10 text-biz-ink', btn: 'bg-biz' },
};

const prezentacje = (n) => {
  const t = n % 10;
  const h = n % 100;
  if (n === 1) return 'prezentacja';
  if (t >= 2 && t <= 4 && !(h >= 12 && h <= 14)) return 'prezentacje';
  return 'prezentacji';
};
---

<BaseLayout
  title="Agenda 2026 · Programistok"
  description="Program Programistok 2026: 24 prezentacje w dwa dni, dwie ścieżki (IT i Business). Ogłaszamy stopniowo. 25.09 i 26.09.2026, Białystok."
>
  <!-- ===== HERO ===== -->
  <section class="mx-auto max-w-[1200px] px-5 pb-8 pt-14 sm:px-8 lg:pt-20" aria-labelledby="agenda-title">
    <p class="mb-4 font-mono text-[13px] uppercase tracking-[0.16em] text-faint">// Program</p>

    <h1 id="agenda-title" class="max-w-[16ch] text-balance text-[clamp(2.25rem,6vw,4.5rem)] font-black leading-[0.98] tracking-[-0.04em]">
      Agenda <span class="text-accent">'26</span>
    </h1>

    <p class="mt-6 max-w-[58ch] text-[clamp(1.125rem,2vw,1.4375rem)] leading-relaxed text-muted text-pretty">
      {total} {prezentacje(total)} w dwa dni, w dwóch ścieżkach po {tracks[0].slots}. Program ogłaszamy
      stopniowo. Podział na dni i godziny opublikujemy, gdy będzie kompletny.
    </p>

    <p class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-sm uppercase tracking-wide text-faint">
      <span class="inline-flex items-center gap-2 text-ink">
        <span class="h-3 w-3 rounded-[3px] bg-accent" aria-hidden="true"></span>25.09 i 26.09.2026
      </span>
      <span aria-hidden="true">//</span>
      <span>Politechnika Białostocka</span>
    </p>
  </section>

  <!-- ===== ŚCIEŻKI ===== -->
  {tracks.map((track) => (
    <section id={track.id} class="mx-auto max-w-[1200px] px-5 py-8 sm:px-8 lg:py-12" aria-labelledby={`track-${track.id}`}>
      <div class={`mb-6 h-1.5 w-16 rounded-full ${theme[track.id].bar}`}></div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <h2 id={`track-${track.id}`} class="text-balance text-[clamp(2rem,5vw,3.25rem)] font-black leading-[1.02] tracking-[-0.03em]">
          {track.name}
        </h2>
        <span class={`rounded-full px-3 py-1 font-mono text-[12px] uppercase tracking-[0.1em] ${theme[track.id].chip}`}>
          {track.slots} {prezentacje(track.slots)}
        </span>
      </div>

      <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-muted text-pretty">{track.lead}</p>

      <div class="mt-10 flex flex-col gap-5">
        {track.speakers.map((s) => <SpeakerCard speaker={s} track={track.id} />)}

        <div class="flex flex-wrap items-center justify-between gap-5 rounded-3xl border border-dashed border-line bg-surface/50 px-7 py-8 sm:px-9">
          <div>
            <p class={`mb-2 font-mono text-[12px] uppercase tracking-[0.12em] ${theme[track.id].label}`}>Wkrótce</p>
            <p class="text-balance text-[17px] font-bold leading-snug text-ink">
              Kolejne wystąpienia ogłosimy w najbliższych tygodniach
            </p>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-relaxed text-muted text-pretty">
              Kilka miejsc wciąż czeka na zgłoszenia.
            </p>
          </div>
          <a
            href={agenda.cfp.forms[track.id]}
            rel="noopener"
            target="_blank"
            class={`inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[15px] font-bold text-white transition hover:brightness-110 ${theme[track.id].btn}`}
          >
            Zgłoś prelekcję {track.label} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  ))}

  <!-- ===== CFP ===== -->
  <section id="cfp" class="mx-auto max-w-[1200px] px-5 py-8 sm:px-8 lg:py-14" aria-label="Call for Papers">
    <Cfp tone="dark" />
  </section>

  <!-- ===== BILETY ===== -->
  <section class="mx-auto max-w-[1200px] px-5 pb-14 sm:px-8" aria-label="Bilety">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-3xl border border-line bg-surface px-6 py-10 sm:px-12">
      <div>
        <h2 class="text-balance text-2xl font-black tracking-[-0.02em]">Jeden bilet, obie ścieżki</h2>
        <p class="mt-2 max-w-[46ch] text-[15px] leading-relaxed text-muted text-pretty">
          Między ścieżkami przechodzisz swobodnie. Przerwy, lunch i networking są wspólne.
        </p>
      </div>
      <a
        href="https://programistok2026.konfeo.com/pl/groups"
        rel="noopener"
        target="_blank"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-4 text-base font-bold text-white transition hover:brightness-110"
      >
        Kup bilety <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
