---
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionRow from '../components/SessionRow.astro';
import Cfp from '../components/Cfp.astro';
import { cfp, days, tracks, sessionsFor } from '../lib/agenda.js';

const theme = {
  it: { bar: 'bg-accent', dot: 'bg-accent', label: 'text-accent-ink', btn: 'bg-accent' },
  biznes: { bar: 'bg-biz', dot: 'bg-biz', label: 'text-biz-ink', btn: 'bg-biz' },
};
---

<BaseLayout
  title="Agenda 2026 · Programistok"
  description="Program Programistok 2026: dwa dni, dwie ścieżki: IT i biznes. Prezentacje, lightning talki i case studies. 25-26.09.2026, Białystok."
>
  <!-- ===== HERO ===== -->
  <section class="mx-auto max-w-[1200px] px-5 pb-6 pt-14 sm:px-8 lg:pt-20" aria-labelledby="agenda-title">
    <p class="mb-4 font-mono text-[13px] uppercase tracking-[0.16em] text-faint">// Program</p>

    <h1 id="agenda-title" class="max-w-[16ch] text-balance text-[clamp(2.25rem,6vw,4.5rem)] font-black leading-[0.98] tracking-[-0.04em]">
      Agenda <span class="text-accent">'26</span>
    </h1>

    <p class="mt-6 max-w-[58ch] text-[clamp(1.125rem,2vw,1.4375rem)] leading-relaxed text-muted text-pretty">
      Dwa dni, dwie ścieżki obok siebie. Program w kolejności wystąpień, opisy prelekcji
      po kliknięciu. Godziny i przerwy opublikujemy bliżej konferencji.
    </p>

    <nav class="mt-8 flex flex-wrap gap-3" aria-label="Skocz do dnia">
      {days.map((day) => (
        <a
          href={`#dzien-${day.id}`}
          class="inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-5 py-3 text-[15px] font-bold tracking-[-0.01em] text-ink transition hover:border-ink/25 hover:bg-bg"
        >
          {day.label}
          <span class="font-mono text-[13px] font-normal tracking-wide text-faint">{day.dateLabel}</span>
        </a>
      ))}
    </nav>

    <p class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-sm uppercase tracking-wide text-faint">
      <span class="inline-flex items-center gap-2 text-ink">
        <span class="h-3 w-3 rounded-[3px] bg-accent" aria-hidden="true"></span>25-26.09.2026
      </span>
      <span aria-hidden="true">//</span>
      <span>Politechnika Białostocka</span>
    </p>
  </section>

  <!-- ===== DNI ===== -->
  {days.map((day) => (
    <section id={`dzien-${day.id}`} class="mx-auto max-w-[1200px] scroll-mt-20 px-5 py-8 sm:px-8 lg:py-10" aria-labelledby={`dzien-${day.id}-title`}>
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t border-line pt-7">
        <h2 id={`dzien-${day.id}-title`} class="text-[clamp(1.75rem,4vw,2.5rem)] font-black tracking-[-0.03em]">
          {day.label}
        </h2>
        <span class="font-mono text-[13px] uppercase tracking-[0.14em] text-faint">{day.dateLabel}</span>
      </div>

      <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-8">
        {tracks.map((track) => (
          <div id={day.id === 1 ? track.id : undefined} class="scroll-mt-24">
            <div class="sticky top-[68px] z-10 -mx-1 flex items-center gap-2.5 bg-bg/90 px-1 py-2.5 backdrop-blur">
              <span class={`h-2.5 w-2.5 shrink-0 rounded-[3px] ${theme[track.id].bar}`} aria-hidden="true"></span>
              <h3 class="text-[15px] font-black uppercase tracking-[0.08em]">Ścieżka {track.label}</h3>
            </div>

            <div class="mt-2 flex flex-col gap-3">
              {sessionsFor(track.id, day.id).map((session) => (
                <SessionRow session={session} track={track.id} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <!-- ===== ŚCIEŻKI: OPIS + CFP ===== -->
  <section class="mx-auto max-w-[1200px] px-5 py-8 sm:px-8 lg:py-12" aria-label="O ścieżkach">
    <div class="grid gap-5 md:grid-cols-2">
      {tracks.map((track) => (
        <article class="flex flex-col rounded-3xl border border-line bg-surface p-8 sm:p-10">
          <div class={`mb-5 h-1.5 w-12 rounded-full ${theme[track.id].bar}`}></div>
          <h2 class="text-balance text-2xl font-black tracking-[-0.02em]">{track.name}</h2>
          <p class="mt-3 flex-1 text-[15px] leading-relaxed text-muted text-pretty">{track.lead}</p>
          {cfp.open && (
            <a
              href={cfp.forms[track.id]}
              rel="noopener"
              target="_blank"
              class={`mt-6 inline-flex items-center gap-2 self-start rounded-full px-6 py-3.5 text-[15px] font-bold text-white transition hover:brightness-110 ${theme[track.id].btn}`}
            >
              Zgłoś prelekcję {track.label} <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ===== CFP ===== -->
  {cfp.open && (
    <section id="cfp" class="mx-auto max-w-[1200px] px-5 py-8 sm:px-8 lg:py-14" aria-label="Call for Papers">
      <Cfp tone="dark" />
    </section>
  )}

  <!-- ===== BILETY ===== -->
  <section class="mx-auto max-w-[1200px] px-5 pb-14 sm:px-8" aria-label="Bilety">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-3xl border border-line bg-surface px-6 py-10 sm:px-12">
      <div>
        <h2 class="text-balance text-2xl font-black tracking-[-0.02em]">Jeden bilet, obie ścieżki</h2>
        <p class="mt-2 max-w-[46ch] text-[15px] leading-relaxed text-muted text-pretty">
          Między ścieżkami przechodzisz swobodnie. Przerwy, lunch i networking są wspólne.
        </p>
      </div>
      <a
        href="https://programistok2026.konfeo.com/pl/groups"
        rel="noopener"
        target="_blank"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-4 text-base font-bold text-white transition hover:brightness-110"
      >
        Kup bilety <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
