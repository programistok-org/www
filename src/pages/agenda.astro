---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timetable from '../components/Timetable.astro';
import Cfp from '../components/Cfp.astro';
import { cfp, days } from '../lib/agenda.js';
import { venue } from '../lib/venue.js';
---

<BaseLayout
  title="Agenda 2026 · Programistok"
  description="Program Programistok 2026: dwa dni, dwie ścieżki: IT i biznes. Prezentacje, lightning talki i case studies. 25-26.09.2026, Białystok."
>
  <!-- ===== HERO ===== -->
  <section class="mx-auto max-w-[1200px] px-5 pb-6 pt-14 sm:px-8 lg:pt-20" aria-labelledby="agenda-title">
    <p class="mb-4 font-mono text-[13px] uppercase tracking-[0.16em] text-faint">// Program</p>

    <h1 id="agenda-title" class="max-w-[16ch] text-balance text-[clamp(2.25rem,6vw,4.5rem)] font-black leading-[0.98] tracking-[-0.04em]">
      Agenda <span class="text-accent">'26</span>
    </h1>

    <p class="mt-6 max-w-[58ch] text-[clamp(1.125rem,2vw,1.4375rem)] leading-relaxed text-muted text-pretty">
      Trzydzieści ekspertek i ekspertów na dwóch scenach.<br />
      Dwa dni konkretów z architektury, AI i biznesu, po których w poniedziałek wiesz, co zrobić inaczej.
    </p>

    <nav class="mt-8 flex flex-wrap gap-3" aria-label="Skocz do dnia">
      {days.map((day) => (
        <a
          href={`#dzien-${day.id}`}
          class="inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-5 py-3 text-[15px] font-bold tracking-[-0.01em] text-ink transition hover:border-ink/25 hover:bg-bg"
        >
          {day.label}
          <span class="font-mono text-[13px] font-normal tracking-wide text-faint">{day.dateLabel}</span>
        </a>
      ))}
    </nav>

    <p class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-sm uppercase tracking-wide text-faint">
      <span class="inline-flex items-center gap-2 text-ink">
        <span class="h-3 w-3 rounded-[3px] bg-accent" aria-hidden="true"></span>25-26.09.2026
      </span>
      <span aria-hidden="true">//</span>
      <a href={venue.mapsUrl} rel="noopener" target="_blank" class="underline decoration-line underline-offset-4 transition hover:text-ink">
        {venue.shortName} <span aria-hidden="true">↗</span>
      </a>
    </p>
  </section>

  <!-- ===== DNI ===== -->
  {days.map((day, i) => (
    <>
    {i > 0 && (
      <section class="mx-auto max-w-[1200px] px-5 py-8 sm:px-8 lg:py-10" aria-label="Bilety">
        <div class="flex flex-wrap items-center justify-between gap-6 rounded-3xl bg-ink px-6 py-10 text-cream sm:px-12 lg:py-12">
          <div>
            <h2 class="text-balance text-[clamp(1.75rem,3.5vw,2.5rem)] font-black leading-[1.05] tracking-[-0.03em]">
              Podoba Ci się, co widzisz?
            </h2>
            <p class="mt-2 max-w-[46ch] text-[17px] leading-relaxed text-cream-dim text-pretty">Dołącz do nas 25–26 września w Białymstoku.</p>
          </div>
          <a
            href="https://programistok2026.konfeo.com/pl/groups"
            rel="noopener"
            target="_blank"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-4 text-base font-bold text-white transition hover:brightness-110"
          >
            Kup bilet <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    )}
    <section id={`dzien-${day.id}`} class="mx-auto max-w-[1200px] scroll-mt-20 px-5 py-8 sm:px-8 lg:py-10" aria-labelledby={`dzien-${day.id}-title`}>
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t border-line pt-7">
        <h2 id={`dzien-${day.id}-title`} class="text-[clamp(1.75rem,4vw,2.5rem)] font-black tracking-[-0.03em]">
          {day.label}
        </h2>
        <span class="font-mono text-[13px] uppercase tracking-[0.14em] text-faint">{day.dateLabel}</span>
      </div>

      <Timetable day={day} />
    </section>
    </>
  ))}

  <!-- ===== CFP ===== -->
  {cfp.open && (
    <section id="cfp" class="mx-auto max-w-[1200px] px-5 py-8 sm:px-8 lg:py-14" aria-label="Call for Papers">
      <Cfp tone="dark" />
    </section>
  )}

  <!-- ===== BILETY ===== -->
  <section class="mx-auto max-w-[1200px] px-5 pb-14 sm:px-8" aria-label="Bilety">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-3xl border border-line bg-surface px-6 py-10 sm:px-12">
      <div>
        <h2 class="text-balance text-2xl font-black tracking-[-0.02em]">Jeden bilet, obie ścieżki</h2>
        <p class="mt-2 max-w-[46ch] text-[15px] leading-relaxed text-muted text-pretty">
          Między ścieżkami przechodzisz swobodnie, także w trakcie dnia.
        </p>
      </div>
      <a
        href="https://programistok2026.konfeo.com/pl/groups"
        rel="noopener"
        target="_blank"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-4 text-base font-bold text-white transition hover:brightness-110"
      >
        Kup bilety <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <script>
    // modale sesji: otwieranie z siatki, adres #sesja-… pozwala podlinkować konkretną prelekcję
    const open = (id: string) => {
      const dialog = document.getElementById(id);
      if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
      dialog.showModal();
      history.replaceState(null, '', `#${id}`);
    };

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLElement>('[data-open]');
      if (trigger?.dataset.open) open(trigger.dataset.open);

      const tab = target.closest<HTMLElement>('[data-tab]');
      const timetable = tab?.closest<HTMLElement>('[data-timetable]');
      if (tab && timetable) {
        timetable.dataset.active = tab.dataset.tab;
        timetable.querySelectorAll('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      }
    });

    document.querySelectorAll<HTMLDialogElement>('.session-modal').forEach((dialog) => {
      dialog.addEventListener('close', () => history.replaceState(null, '', location.pathname + location.search));
    });

    if (location.hash.startsWith('#sesja-')) open(location.hash.slice(1));

    // marquee tylko tam, gdzie tekst faktycznie się nie mieści; ResizeObserver
    // łapie też zmianę zakładki na telefonie (ukryty panel ma szerokość 0)
    const fit = (el: HTMLElement) => {
      const shift = (el.firstElementChild as HTMLElement).scrollWidth - el.clientWidth;
      if (el.clientWidth > 0 && shift > 2) {
        el.dataset.overflow = '';
        el.style.setProperty('--marquee-shift', `-${shift + 4}px`);
        el.style.setProperty('--marquee-duration', `${Math.max(5, shift / 18)}s`);
      } else {
        delete el.dataset.overflow;
      }
    };
    const observer = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
    document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
